{
  "name": "@cstcood/dsh-live-process",
  "version": "1.5.1",
  "type": "module",
  "description": "Live-process blocks for the Chat transcript: reasoning and tool rows open while running, fold when settled, and carry configurable block styling from a Settings page.",
  "license": "MIT",
  "author": "cstcood",
  "homepage": "https://github.com/cstcood/dsh-live-process#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstcood/dsh-live-process.git"
  },
  "bugs": {
    "url": "https://github.com/cstcood/dsh-live-process/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "reasoning",
    "ui"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
